{
  "name": "postispop-astro-storefront",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "npm run build:store && node scripts/render-board.mjs && node scripts/build-content.mjs && node scripts/stage-site.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "test:mobile": "node tests/mobile-ui.cjs",
    "build:store": "astro check && astro build && pagefind --site astro-dist",
    "lint": "eslint app guest-board.js supabase-bridge.js commerce-ui.js scripts/*.mjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:site": "node tests/site-ui.cjs",
    "test:pwa": "node tests/pwa-ui.cjs"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.12",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "pagefind": "^1.3.0",
    "playwright": "1.56.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2"
  }
}
