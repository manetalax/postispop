{
  "name": "postispop-astro-storefront",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "node scripts/build-guides.mjs && astro check && astro build && pagefind --site astro-dist",
    "preview": "astro preview --host 0.0.0.0",
    "test:mobile": "node tests/mobile-ui.cjs",
    "test": "node --test tests/*.test.cjs",
    "lint": "node scripts/check-js.mjs",
    "test:experience": "node tests/experience-ui.cjs",
    "test:premium": "node tests/premium-ui.cjs",
    "test:atelier": "node tests/atelier-ui.cjs",
    "test:protected": "node tests/protected-share-ui.cjs && node tests/protected-concurrency-ui.cjs",
    "test:offline-shell": "node tests/offline-shell-ui.cjs",
    "test:cloud-import": "node tests/cloud-import-ui.cjs",
    "test:autosave": "node tests/autosave-ui.cjs",
    "test:devices": "node tests/devices-ui.cjs"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@tailwindcss/vite": "^4.1.12",
    "pagefind": "^1.3.0",
    "playwright": "1.56.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2"
  }
}
