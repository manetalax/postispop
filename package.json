{
  "name": "postispop-astro-storefront",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "node scripts/build-guides.mjs && astro check && astro build && pagefind --site astro-dist",
    "preview": "astro preview --host 0.0.0.0",
    "test:mobile": "node tests/mobile-ui.cjs",
    "test:backup": "node --test tests/attachment-backup-ui.cjs",
    "test:exports": "node --test tests/png-export-ui.cjs",
    "test": "node --test tests/*.test.cjs",
    "lint": "node scripts/check-js.mjs",
    "test:experience": "node tests/experience-ui.cjs",
    "test:premium": "node tests/premium-ui.cjs",
    "test:atelier": "node tests/atelier-ui.cjs",
    "test:protected": "node tests/protected-share-ui.cjs && node tests/protected-concurrency-ui.cjs",
    "test:offline-shell": "node tests/offline-shell-ui.cjs",
    "test:cloud-import": "node tests/cloud-import-ui.cjs",
    "test:autosave": "node tests/autosave-ui.cjs",
    "test:devices": "node tests/devices-ui.cjs",
    "test:daily-quote": "node tests/daily-quote-ui.cjs",
    "test:notes-first": "node tests/notes-first-ui.cjs && node tests/add-note-ui.cjs",
    "test:android-auth": "node tests/android-auth-ui.cjs",
    "test:database": "node tests/database-integration.mjs",
    "audit:quality": "node scripts/audit-quality.mjs",
    "test:hydration": "node tests/hydration-ui.cjs"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.1.12",
    "axe-core": "^4.14.0",
    "lighthouse": "^13.5.0",
    "pagefind": "^1.3.0",
    "playwright": "1.56.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2"
  }
}
