---
/** Keep old bookmarked shop URLs useful without publishing obsolete offers. */
interface Props {
  destination?: '/' | '/atelier.html';
}
const { destination = '/atelier.html' } = Astro.props;
const canonical = new URL(destination, 'https://postispop.com').href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="description" content="PostisPop: seis notas gratis y un único Premium. Continúa a la oferta actual." />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <title>Continuar a PostisPop</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="stylesheet" href="/atelier.css" />
  </head>
  <body>
    <main class="pricing-intro">
      <h1>Tus ideas a la vista.</h1>
      <p>La tienda se ha simplificado: seis notas gratis y un único Premium.</p>
      <p><a class="start-link" href={destination}>{destination === '/' ? 'Volver a mis notas' : 'Ver Gratis y Premium'}</a></p>
    </main>
  </body>
</html>
