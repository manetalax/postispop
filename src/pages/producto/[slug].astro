---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({ params: { slug: product.id.replace(/\.md$/, '') }, props: { product } }));
}
const { product } = Astro.props;
const { Content } = await render(product);
const { title, price, franchise, category, coverImage, coverAlt, inStock, description, variants } = product.data;
const slug = product.id.replace(/\.md$/, '');
const base = import.meta.env.BASE_URL;
const site = 'https://postispop.com';
const canonicalPath = `producto/${slug}/`;
const canonical = `${site}${base}${canonicalPath}`;
const checkoutUrl = `/?shop=1&item=${encodeURIComponent(slug)}`;
const ld = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}${base}` },
      { '@type': 'ListItem', position: 2, name: 'Catálogo', item: `${site}${base}` },
      { '@type': 'ListItem', position: 3, name: title, item: canonical },
    ] },
    { '@type': 'Product', name: title, description, image: `${site}${coverImage.src}`, category, brand: { '@type': 'Brand', name: franchise }, sku: slug,
      offers: { '@type': 'Offer', url: canonical, priceCurrency: 'EUR', price: price.toFixed(2), availability: inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock', itemCondition: 'https://schema.org/NewCondition' } },
  ],
};
const jsonLd = JSON.stringify(ld).replace(/</g, '\\u003c');
---
<Layout title={`${title} | PostisPop`} description={`${description} Disponible por ${price.toFixed(2).replace('.', ',')} €. Mira los detalles y personaliza tu pizarra PostisPop.`} canonicalPath={canonicalPath} pageKind="product" preloadImage={coverImage.src}>
  <Fragment slot="head"><script type="application/ld+json" set:html={jsonLd}></script></Fragment>
  <main id="contenido" class="mx-auto max-w-6xl px-4 py-5 sm:px-6 sm:py-9">
    <nav aria-label="Migas de pan" class="mb-4 text-sm text-muted"><a href={base} data-astro-prefetch>Catálogo</a><span aria-hidden="true"> / </span><span aria-current="page">{title}</span></nav>
    <article class="grid items-start gap-6 lg:grid-cols-2 lg:gap-12">
      <div class="overflow-hidden rounded-3xl border border-line bg-paper-soft lg:sticky lg:top-24">
        <Picture src={coverImage} alt={coverAlt} formats={['avif', 'webp']} widths={[480, 760, 1100]} sizes="(min-width: 1024px) 50vw, 100vw" loading="eager" fetchpriority="high" decoding="async" class="aspect-[4/3] w-full object-cover" />
      </div>
      <section aria-labelledby="product-title" class="pt-1">
        <p class="text-sm font-bold uppercase tracking-wide text-pop">{franchise} · {category}</p>
        <h1 id="product-title" class="mt-2 text-3xl font-black leading-tight sm:text-4xl">{title}</h1>
        <p class="mt-4 text-3xl font-extrabold">€{price.toFixed(2).replace('.', ',')}</p>
        <p class="mt-2 text-sm font-semibold" class:list={{ 'text-emerald-700': inStock, 'text-red-700': !inStock }}>{inStock ? 'Disponible' : 'Agotado'}</p>
        <div class="prose-postispop mt-5 text-muted"><p>{description}</p><Content /></div>
        {variants.length > 0 && <fieldset class="mt-6"><legend class="mb-2 font-bold">Opciones</legend><div class="flex flex-wrap gap-2">{variants.map((variant) => <label class="cursor-pointer rounded-xl border border-line px-4 py-3 has-[:checked]:border-pop has-[:checked]:bg-pop/5"><input class="sr-only" type="radio" name="variant" value={variant.name} checked={variants.indexOf(variant) === 0} /><span class="font-semibold">{variant.name}</span>{variant.price != null && <span class="ml-2 text-sm text-muted">€{variant.price.toFixed(2)}</span>}</label>)}</div></fieldset>}
        <a href={checkoutUrl} data-astro-reload class="mt-6 flex min-h-14 w-full items-center justify-center rounded-2xl bg-pop px-6 text-center text-lg font-extrabold text-white hover:bg-pop-dark">{slug === 'reloj-recordatorios' ? 'Añadir reloj a mi pizarra' : 'Elegir este producto'}</a>
        <p class="mt-3 text-sm text-muted">La compra se completa de forma segura desde tu pizarra PostisPop.</p>
        {slug === 'reloj-recordatorios' && <p class="mt-3 rounded-xl bg-paper-soft p-3 text-sm">Al registrarte recibes 30 días gratis para probar las alarmas.</p>}
      </section>
    </article>
  </main>
</Layout>
