---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';

const products = (await getCollection('products')).sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const franchises = [...new Set(products.map(({ data }) => data.franchise))];
const categories = [...new Set(products.map(({ data }) => data.category))];
const description = 'Descubre papelería digital, recordatorios con alarma y mejoras para organizar tus notas. Explora el catálogo PostisPop y elige tu herramienta.';
---

<Layout title="Papelería digital y notas con alarma | PostisPop" description={description} canonicalPath="" pageKind="catalog">
  <link slot="head" rel="preload" as="image" href="/assets/board-scene.webp" type="image/webp" fetchpriority="high" />
  <main id="contenido" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <section class="grid items-center gap-7 py-9 sm:py-14 lg:grid-cols-[1.1fr_.9fr] lg:gap-12" aria-labelledby="hero-title">
      <div>
        <p class="mb-3 text-sm font-bold uppercase tracking-[.18em] text-pop">Ideas a la vista, días bajo control</p>
        <h1 id="hero-title" class="max-w-2xl text-4xl font-black leading-tight tracking-tight sm:text-5xl">Tu espacio creativo para notas que sí recuerdas</h1>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">Personaliza tu pizarra PostisPop con papelería digital y añade alarmas a tus notas importantes.</p>
        <a href="#productos" class="mt-6 inline-flex min-h-12 items-center justify-center rounded-full bg-pop px-6 font-bold text-white hover:bg-pop-dark">Explorar productos</a>
      </div>
      <div class="hero-art overflow-hidden rounded-[2rem] border border-line bg-paper-soft">
        <img src="/assets/board-scene.webp" alt="Pizarra PostisPop con notas digitales" width="960" height="640" fetchpriority="high" decoding="async" class="aspect-[3/2] w-full object-cover" />
      </div>
    </section>

    <section id="productos" class="scroll-mt-24 pb-16" aria-labelledby="catalog-title" data-catalog>
      <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
        <div><p class="text-sm font-bold text-pop">Catálogo PostisPop</p><h2 id="catalog-title" class="mt-1 text-2xl font-extrabold sm:text-3xl">Mejoras para tu pizarra</h2></div>
        <p class="text-sm text-muted">{products.length} productos digitales</p>
      </div>
      <nav class="mb-6 flex snap-x gap-2 overflow-x-auto pb-2" aria-label="Filtros rápidos del catálogo">
        <button type="button" data-filter="all" aria-pressed="true" class="filter-chip shrink-0 snap-start rounded-full border border-pop bg-pop px-4 py-2 text-sm font-semibold text-white">Todo</button>
        {categories.map((category) => <button type="button" data-filter={category.toLowerCase()} aria-pressed="false" class="filter-chip shrink-0 snap-start rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold">{category}</button>)}
        {franchises.map((franchise) => <button type="button" data-filter={franchise.toLowerCase()} aria-pressed="false" class="filter-chip shrink-0 snap-start rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold">{franchise}</button>)}
      </nav>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4" data-product-grid>
        {products.map((product, index) => <ProductCard product={product} eager={index < 2} />)}
      </div>
      <p class="mt-5 hidden rounded-xl bg-paper-soft p-4 text-center text-sm text-muted" data-empty-filter role="status">No hay productos en este filtro.</p>
    </section>

    <section class="content-section mb-16 rounded-3xl bg-ink p-6 text-white sm:p-9" aria-labelledby="clock-title">
      <div class="max-w-3xl"><p class="text-sm font-semibold text-red-300">Recordatorios puntuales</p><h2 id="clock-title" class="mt-2 text-2xl font-extrabold sm:text-3xl">Convierte una nota en una alarma</h2><p class="mt-3 leading-relaxed text-white/75">El Reloj y recordatorios añade fecha y hora a tus notas. Regístrate y úsalo gratis durante 30 días; después puedes comprarlo para seguir creando notas con alarma.</p><a href="/producto/reloj-recordatorios/" class="mt-5 inline-flex min-h-12 items-center rounded-full bg-white px-5 font-bold text-ink" data-astro-prefetch>Ver Reloj y recordatorios</a></div>
    </section>
  </main>
</Layout>
