<?xml version="1.0" encoding="utf-8"?>
<!-- Notes, account sessions and PKCE state migrate only through explicit
     PostisPop export/sync, never through an automatic device backup. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
